# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Strong random secret (JWT, OAuth state, gateway encryption)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=file:./.data/dev.sqlite
# Production (MySQL):
# DATABASE_URL=mysql://user:pass@host:3306/nasab
# Production (Neon / PostgreSQL) — use the pooled connection string:
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Public URL & proxy (production) ────────────────────────────
APP_PUBLIC_URL=http://localhost:5173
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend (build-time — required for npm run build) ─────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; gets role "admin" on first login

# ── Local dev login (development only — disabled in production) ─
DEV_LOCAL_AUTH=true
DEV_LOGIN_USER=admin
DEV_LOGIN_PASSWORD=admin123

# ── Google OAuth (optional) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI in Google Console: https://yourdomain.com/api/oauth/google/callback

# ── Payment webhooks (register in gateway dashboards) ───────────
# Thawani:  https://yourdomain.com/api/webhooks/thawani
# Stripe:   https://yourdomain.com/api/webhooks/stripe
# PayPal:   https://yourdomain.com/api/webhooks/paypal

# ── Production template ─────────────────────────────────────────
# See .env.production.example and DEPLOY.md for full launch steps.