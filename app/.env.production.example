# ═══════════════════════════════════════════════════════════════
# نَسَب — نموذج بيئة الإنتاج (انسخ إلى .env على السيرفر)
# cp .env.production.example .env
# أو: node scripts/configure-launch.mjs --domain=https://... --union-id=...
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# أسرار قوية — لا تشاركها
# توليد APP_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_ID=
APP_SECRET=

# قاعدة البيانات (إلزامي في الإنتاج) — MySQL أو Neon PostgreSQL
# DATABASE_URL=mysql://nasab:CHANGE_ME_STRONG@db:3306/nasab
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# MySQL فقط عند استخدام docker-compose مع خدمة db:
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=nasab
MYSQL_USER=nasab
MYSQL_PASSWORD=CHANGE_ME_STRONG

# الرابط العام للموقع (HTTPS إلزامي للكوكيز الآمنة)
APP_PUBLIC_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com
TRUST_PROXY=true

# Kimi OAuth
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
VITE_KIMI_AUTH_URL=https://auth.kimi.com
VITE_APP_ID=

# مشرف: إمّا OWNER_UNION_ID، أو اتركه فارغاً ليصبح أول داخل مشرفاً (BOOTSTRAP_FIRST_ADMIN)
OWNER_UNION_ID=
BOOTSTRAP_FIRST_ADMIN=true

# بيانات التحويل البنكي (تُملأ تلقائياً في بوابة bank_transfer إن كانت الحقول فارغة)
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_INSTRUCTIONS=
# Google OAuth (اختياري)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ممنوع: DEV_LOCAL_AUTH=true في الإنتاج
DEV_LOCAL_AUTH=false

# دخول بالبريد (اختياري — يظهر نموذج البريد/كلمة المرور على /login)
PASSWORD_LOGIN_EMAIL=admin@example.com
PASSWORD_LOGIN_PASSWORD=CHANGE_ME_STRONG
